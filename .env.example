# ORCA runtime configuration template.
#
# Copy this file to .env for local development. Docker does not copy .env into
# any image. docker compose reads these values for build args and runtime
# environment substitution. In Dokploy, set the same keys in the environment
# configuration panel instead of committing a real .env file.
#
# Keep this file limited to variables that are still used by the MVP.

# FastAPI runtime
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Docker service URLs
DATABASE_URL=postgresql://orca:orca_pass@postgres:5432/orca_db
REDIS_URL=redis://redis:6379

# Optional local host URLs when running apps outside Docker
DEV_DATABASE_URL=postgresql://orca:orca_pass@localhost:5437/orca_db
DEV_REDIS_URL=redis://localhost:6380
PREDICTION_CACHE_TTL_SECONDS=900

# API auth and throttling
INTERNAL_API_TOKEN=orca-internal-local-token
PUBLIC_API_TOKEN=orca-public-local-token
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# MLflow model loading. Default compose keeps MLflow optional to reduce local load.
# Run docker compose with profile ml only when the trained model registry is needed.
MLFLOW_TRACKING_URI=http://mlflow:5001
MLFLOW_MODEL_NAME=delay-predictor
MLFLOW_MODEL_STAGE=Production

# Next.js public variables are baked into the web bundle during build.
# Change these before running docker compose build or docker compose up.
NEXT_PUBLIC_API_BASE=http://localhost:8001
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_API_TOKEN=orca-public-local-token

# External integrations
BMKG_API_BASE_URL=https://data.bmkg.go.id/DataMKG/MEWS/DigitalForecast
FONNTE_API_KEY=
FONNTE_API_URL=https://api.fonnte.com/send
ALERT_RECIPIENT_PHONE=

# Route optimization
OSMNX_GRAPH_PATH=../../data/processed/osmnx/west_java.graphml
OSMNX_PLACE_NAME=West Java, Indonesia
OSMNX_ENABLE_DOWNLOAD=false

# MVP tuning
ALERT_RISK_THRESHOLD=70.0
SLA_RISK_AMPLIFIER=4.0
DEMO_MODE=true
NSGA2_POPULATION_SIZE=50
NSGA2_GENERATIONS=100