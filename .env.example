# ORCA runtime configuration template.
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Docker Compose reads these values for build args and runtime env substitution.
# Never commit your real .env to git.

# ── FastAPI ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# Docker internal hostname (used by orca-ai container and docker compose services)
DATABASE_URL=postgresql://orca:orca_pass@postgres:5432/orca_db



# ── Redis ────────────────────────────────────────────────────────────────────
# Docker internal hostname
REDIS_URL=redis://redis:6380



PREDICTION_CACHE_TTL_SECONDS=900

# ── API Security ─────────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=orca-internal-local-token
PUBLIC_API_TOKEN=orca-public-local-token
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# ── MLflow (disabled by default) ─────────────────────────────────────────────
# Leave MLFLOW_TRACKING_URI empty to skip MLflow and load model from local files.
# To enable: docker compose --profile ml up  and set URI to http://mlflow:5001
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=delay-predictor
MLFLOW_MODEL_STAGE=Staging

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the bundle at build time.
# For local dev (make dev-web): point to backend running on host.
# For Docker (make up): use the docker-compose default http://localhost:8010.
NEXT_PUBLIC_API_BASE=http://localhost:8001
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_API_TOKEN=orca-public-local-token

# ── External integrations (all optional) ─────────────────────────────────────
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
TOMTOM_API_KEY=
STADIA_API_KEY=
FONNTE_API_KEY=
FONNTE_API_URL=https://api.fonnte.com/send
ALERT_RECIPIENT_PHONE=

# ── ML model ─────────────────────────────────────────────────────────────────
# Path to model file. Inside Docker container /data is mounted from ./data.
# For local dev this is resolved relative to apps/orca-ai automatically.
# Supported: .pkl (CalibratedClassifierCV) or .lgbm (native LightGBM booster)
MODEL_PATH=/data/processed/model.lgbm

# ── Route optimization (OSMnx) ───────────────────────────────────────────────
# Inside Docker the /data mount is used. For local dev the path is resolved
# relative to apps/orca-ai (../../data/...).
OSMNX_GRAPH_PATH=/data/processed/osmnx/jabodetabek.pkl
OSMNX_PLACE_NAME=West Java, Indonesia
OSMNX_ENABLE_DOWNLOAD=false

# ── Tuning ───────────────────────────────────────────────────────────────────
ALERT_RISK_THRESHOLD=70.0
SLA_RISK_AMPLIFIER=1.3
DEMO_MODE=false
NSGA2_POPULATION_SIZE=50
NSGA2_GENERATIONS=100
