APP_ENV=development
APP_PORT=8000
DEBUG=true

# PostgreSQL and Redis
# Docker network URLs (used by orca-ai/orca-engine containers).
DATABASE_URL=postgresql://orca:orca_pass@postgres:5432/orca_db
REDIS_URL=redis://redis:6379
# Host-side URLs (used by local scripts: seed_db.py, train_delay.py, etc.).
# Postgres is exposed on host port 5437, Redis on 6380, to avoid clashing
# with locally installed Postgres (5432) and Redis (6379).
DEV_DATABASE_URL=postgresql://orca:orca_pass@localhost:5437/orca_db
DEV_REDIS_URL=redis://localhost:6380
PREDICTION_CACHE_TTL_SECONDS=900

# Internal service auth
INTERNAL_API_TOKEN=change_me_for_local_dev
PUBLIC_API_TOKEN=change_me_for_public_api
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5001
MLFLOW_MODEL_NAME=delay-predictor
MLFLOW_MODEL_STAGE=Production

# Service URLs
AI_SERVICE_URL=http://orca-ai:8000
PREDICTION_INTERVAL_SECONDS=900
WS_PORT=9090
WS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:9090
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_API_TOKEN=change_me_for_public_api

# External APIs
HERE_MAPS_API_KEY=
BMKG_API_BASE_URL=https://data.bmkg.go.id/DataMKG/MEWS/DigitalForecast
FONNTE_API_KEY=
FONNTE_API_URL=https://api.fonnte.com/send
ALERT_RECIPIENT_PHONE=

# ML/API behavior
# DEMO_MODE=true  → NSGA-II uses pop=30 / gen=50 for fast demo responses (<2s).
# DEMO_MODE=false → uses the values below for full-quality optimization.
# Recommended production settings: POP=100, GEN=200 (latency ~5-15s depending on stop count).
# Recommended demo settings:        POP=30,  GEN=50  (latency <2s for up to 10 stops).
DEMO_MODE=true
NSGA2_POPULATION_SIZE=50
NSGA2_GENERATIONS=100

# SLA risk alert threshold (0–100). Shipments exceeding this score trigger a
# WhatsApp alert via Fonnte. With a calibrated LightGBM model the typical alert
# rate at threshold=70 is ~5–15% of active shipments (high urgency window ≤8h).
# Lower the threshold to catch more at-risk shipments; raise it to reduce noise.
ALERT_RISK_THRESHOLD=70.0

# Optional Kaggle helper
KAGGLE_USERNAME=
KAGGLE_KEY=
